@model IEnumerable<Basmoti_Restaurant.Models.SystemSetting>

@{
    ViewData["Title"] = "Index";
}

<div class="pagetitle">
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item active"><a action="Index">System Setting</a></li>
            @* <li class="breadcrumb-item">Tables</li>
            <li class="breadcrumb-item active">Data</li> *@
        </ol>
    </nav>
</div>

<p>
    <a class="btn btn-primary" asp-action="Create">Create New</a>
</p>


<div class="card">
    <div class="card-body">
        <h5 class="card-title">System Settings</h5>

        <!-- Table with stripped rows -->
        <table class="table datatable">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.SystemSettingLogoImageUrl1)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.SystemSettingLogoImageUrl2)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.SystemSettingCopyright)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.SystemSettingWelcomeNoteTitle)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.SystemSettingWelcomeNoteBreef)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.SystemSettingWelcomeNoteDesc)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.SystemSettingPhone)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.SystemSettingEmail)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.SystemSettingWelcomeNoteUrl)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.SystemSettingWelcomeNoteImageUrl)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.SystemSettingMapLocation)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.SystemSettingMapLocationUrl)
                    </th>
                    <th>Operations</th>

                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <img src="~/images/@item.SystemSettingLogoImageUrl1" style="max-width: 50px" alt="Alternate Text" />
                        </td>
                        <td>
                            <img src="~/images/@item.SystemSettingLogoImageUrl2" style="max-width: 50px" alt="Alternate Text" />
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.SystemSettingCopyright)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.SystemSettingWelcomeNoteTitle)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.SystemSettingWelcomeNoteBreef)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.SystemSettingWelcomeNoteDesc)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.SystemSettingPhone)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.SystemSettingEmail)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.SystemSettingWelcomeNoteUrl)
                        </td>
                        <td>
                            <img src="~/images/@item.SystemSettingWelcomeNoteImageUrl" style="max-width: 50px" alt="Alternate Text" />
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.SystemSettingMapLocation)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.SystemSettingMapLocationUrl)
                        </td>

                        <td>
                            <a asp-action="Edit" asp-route-id="@item.SystemSettingId"> <b> <i class="bi bi-pencil-square text-info fs-4"></i> </b> </a> |
                            <a asp-action="Index" asp-route-toggleId="@item.SystemSettingId">
                                @if (item.IsActive)
                                {
                                    <i class="bi bi-eye text-success fs-4"></i>
                                }
                                else
                                {
                                    <i class="bi bi-eye-slash text-secondary fs-4"></i>
                                }
                            </a>
                            |

                            <a class="csDelete" href="#" data-urls="@Url.Action("", new { DeleteId = item.SystemSettingId })" data-toggle="modal" data-target="#exampleModal"><i class="bi bi-x-circle text-danger fs-4"></i> </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <!-- End Table with stripped rows -->

    </div>
</div>







<script>
    var path="";


     $(function(){
         $(".csDelete").on("click",function(){
             path=$(this).data("urls");
         })
      });

      function ConfirmDelete()
      {
          window.location=path;
          Cancelpath();
      }

     function Cancelpath()
      {
          path="";
      }
</script>


<!-- Modal -->
<div class="modal fade" id="exampleModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Confirm Delete</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                Are you sure to Delete this row?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal" onclick="Cancelpath()">Close</button>
                <button type="button" class="btn btn-danger" onclick="ConfirmDelete()">Delete</button>
            </div>
        </div>
    </div>
</div>


